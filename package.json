{
  "name": "pawtopia-app",
  "version": "1.0.3",
  "description": "Pawtopia, l'appli pour ordinateur (Adopt Me)",
  "author": {
    "name": "Kellyna",
    "email": "kellyna62220@gmail.com"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.pawtopia.app",
    "productName": "Pawtopia",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pawtopia-Windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pawtopia"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "Pawtopia-Mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "artifactName": "Pawtopia-Linux.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "kellyna62220-cyber",
      "repo": "Pawtopia-App",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "Pawtopia",
        "schemes": [
          "pawtopia"
        ]
      }
    ]
  }
}